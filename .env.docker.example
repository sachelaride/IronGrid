# Copie este arquivo para .env.docker antes de iniciar o compose.
# Gere valores exclusivos para cada instalacao e nunca publique o arquivo copiado.

# Portas expostas no host
IRONGRID_HTTP_PORT=3001
IRONGRID_SYSLOG_PORT=514
GRAFANA_PORT=3000
RUSTDESK_HBBS_PORT=21115
RUSTDESK_RENDEZVOUS_TCP_PORT=21116
RUSTDESK_RENDEZVOUS_UDP_PORT=21116
RUSTDESK_RELAY_PORT=21117
RUSTDESK_WEB_CLIENT_PORT=21118
RUSTDESK_RELAY_WEB_PORT=21119

# Banco PostgreSQL usado pelo servidor e pelo coletor Syslog
POSTGRES_USER=irongrid
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=irongrid_db
DATABASE_URL=postgresql://irongrid:troque-por-uma-senha-forte@db:5432/irongrid_db?schema=public
SYSLOG_DATABASE_URL=postgresql://irongrid:troque-por-uma-senha-forte@db:5432/irongrid_db?schema=public

# Banco time-series InfluxDB
INFLUX_INIT_USERNAME=admin
INFLUX_INIT_PASSWORD=troque-por-uma-senha-forte
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=troque-por-um-token-aleatorio
INFLUX_ORG=irongrid
INFLUX_BUCKET=metrics

# Aplicacao
NODE_ENV=production
DEV_PORT=3001
DEBUG=false
GRAFANA_URL=http://grafana:3000
ALLOWED_ORIGIN=http://localhost:3001,http://127.0.0.1:3001

# Segredos da aplicacao: use valores aleatorios longos
JWT_SECRET=troque-por-um-segredo-jwt-aleatorio
AGENT_INGEST_TOKEN=troque-por-um-token-de-ingestao-aleatorio